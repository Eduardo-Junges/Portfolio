---
/**
 * Casca das páginas legais (privacidade e termos).
 *
 * Existe para que as quatro páginas — site e Nexus Analytics, privacidade e
 * termos — tenham a mesma cara e o mesmo cabeçalho. O texto de cada uma fica
 * no slot; aqui só mora o que se repete.
 */
import Base from '../../layouts/Base.astro';

interface Props {
  titulo: string;
  subtitulo: string;
  descricao: string;
  atualizado: string;
  voltarHref: string;
  voltarRotulo: string;
  /** Link cruzado para o documento irmão (privacidade ↔ termos). */
  irmaoHref?: string;
  irmaoRotulo?: string;
}

const { titulo, subtitulo, descricao, atualizado, voltarHref, voltarRotulo, irmaoHref, irmaoRotulo } =
  Astro.props;
---

<Base titulo={`${titulo} — ${subtitulo}`} descricao={descricao}>
  <article class="container-page py-16 sm:py-24">
    <a href={voltarHref} class="label-tec inline-flex items-center gap-1.5 transition-colors hover:text-ink">
      <span aria-hidden="true">←</span> {voltarRotulo}
    </a>

    <header class="mt-8 border-b border-rule pb-8">
      <h1 class="mt-2 font-display text-3xl leading-tight text-balance sm:text-5xl">{titulo}</h1>
      <p class="mt-3 max-w-2xl text-ink-dim">{subtitulo}</p>
      <p class="label-tec mt-4 text-ink-faint">Última atualização: {atualizado}</p>
    </header>

    <div class="prose-tec mt-12 max-w-2xl">
      <slot />
    </div>

    {
      irmaoHref && (
        <div class="mt-12 max-w-2xl border-t border-rule pt-8">
          <a href={irmaoHref} class="label-tec text-accent transition-opacity hover:opacity-70">
            {irmaoRotulo} →
          </a>
        </div>
      )
    }
  </article>
</Base>
