---
/**
 * As seis portas de contato, em duas densidades.
 *
 * `compacto` — só o ícone, para o cabeçalho da home, onde contato é secundário
 *   em relação ao trabalho. O nome da rede continua existindo no `aria-label`,
 *   então leitor de tela e teclado não perdem nada.
 * `completo` — ícone + rede + endereço, para o rodapé e o fim de /sobre, onde
 *   a pessoa já leu e está decidindo por qual porta entrar.
 *
 * A cor de cada rede entra como `--rede-cor` e só se manifesta no hover/foco.
 * Em repouso tudo é `ink-mute`: seis logos coloridos de uma vez virariam
 * barra de compartilhamento de blog, que é o oposto do que este site é.
 */
import { redes } from '../../data/redes';
import IconeRede from './IconeRede.astro';

interface Props {
  variante?: 'compacto' | 'completo';
  class?: string;
}

const { variante = 'compacto', class: classe } = Astro.props;

/*
 * Botão compacto: 36px abaixo de 640px, 40px acima. Em 320px a fila de seis
 * botões de 40px mede 280px para 272px disponíveis, e sobra um botão sozinho na
 * segunda linha.
 */

/** Externo abre em aba nova; `me` marca o link como perfil do próprio autor. */
const alvo = (externo: boolean) =>
  externo ? { target: '_blank', rel: 'me noopener noreferrer' } : {};
---

{
  variante === 'compacto' ? (
    <ul class:list={['flex flex-wrap items-center gap-2', classe]}>
      {redes.map((r) => (
        <li>
          <a
            href={r.href}
            class="btn-rede size-9 justify-center sm:size-10"
            style={`--rede-cor: rgb(${r.cor})`}
            aria-label={r.rotulo}
            title={r.rotulo}
            {...alvo(r.externo)}
          >
            <IconeRede id={r.id} />
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <ul class:list={['grid gap-2 sm:grid-cols-2 lg:grid-cols-3', classe]}>
      {redes.map((r) => (
        <li>
          <a
            href={r.href}
            class="btn-rede h-full w-full gap-3 px-4 py-3"
            style={`--rede-cor: rgb(${r.cor})`}
            {...alvo(r.externo)}
          >
            <IconeRede id={r.id} tamanho={22} />
            <span class="min-w-0">
              <span class="block text-sm font-semibold text-ink">{r.rotulo}</span>
              <span class="block truncate font-mono text-xs text-ink-faint">
                {r.identificador}
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}
