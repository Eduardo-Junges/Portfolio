---
/**
 * Glifos das redes, desenhados em traço — não em preenchimento.
 *
 * O site inteiro fala o vocabulário de desenho técnico: linha fina, sem
 * sombra, sem massa de cor. Um logo chapado quebraria isso. Então cada marca
 * é reconstruída como contorno de 1.6px em `currentColor`, e quem pinta é o
 * botão que envolve o ícone.
 *
 * Cada glifo é só uma lista de `d` — retângulos e círculos incluídos. Assim o
 * componente é um `map`, não uma escada de `if`. Já houve uma interface `Traco`
 * aqui, com `transform` e `larguraTraco`, que existia por causa de um único
 * glifo composto (o fone dentro do balão do WhatsApp). Com ele fora, a
 * estrutura extra não tinha mais nada a sustentar.
 */
import type { IdRede } from '../../data/redes';

const GLIFOS: Record<IdRede, string[]> = {
  // envelope: corpo arredondado + a aba em V
  email: [
    'M5 4.5h14A2.5 2.5 0 0 1 21.5 7v10a2.5 2.5 0 0 1-2.5 2.5H5A2.5 2.5 0 0 1 2.5 17V7A2.5 2.5 0 0 1 5 4.5z',
    'm3.4 6.6 7.3 5.5a2.2 2.2 0 0 0 2.6 0l7.3-5.5',
  ],

  // "in": o ponto, a haste e o arco do n
  linkedin: [
    'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z',
    'M2 9h4v12H2z',
    'M4 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4z',
  ],

  github: [
    'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22',
  ],
};

interface Props {
  id: IdRede;
  tamanho?: number;
}

const { id, tamanho = 20 } = Astro.props;
---

<svg
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {GLIFOS[id].map((d) => <path d={d} />)}
</svg>
