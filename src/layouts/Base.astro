---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/instrument-serif/400.css';
import '../styles/global.css';

/*
 * As fontes só seriam descobertas depois de baixar e parsear o CSS. Estas duas
 * carregam o texto que o visitante lê primeiro (corpo e título), então vão em
 * preload para o download começar junto com o CSS, não depois dele.
 * A JetBrains Mono fica de fora de propósito: só aparece em rótulos pequenos e
 * números, e adiantá-la competiria por banda com as que importam.
 * `?url` faz o Vite devolver o caminho com hash — sem hardcode que quebra a cada build.
 */
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import serifLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import { profile } from '../data/profile';
import AlternarTema from '../components/ui/AlternarTema.astro';

interface Props {
  titulo?: string;
  descricao?: string;
}

const { titulo = profile.seo.titulo, descricao = profile.seo.descricao } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang={profile.seo.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    {/* imagem de compartilhamento — URL absoluta é exigência do protocolo OG */}
    <meta property="og:image" content={new URL('/og.jpg', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Eduardo Junges — projetos de automação, dados e sistemas" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      Resolve o tema antes do primeiro paint: escolha salva > preferência do
      sistema > dark. Fazer isso aqui, e não no CSS, mantém os tokens do tema
      claro declarados uma única vez em global.css.
    */}
    <script is:inline>
      try {
        var salvo = localStorage.getItem('tema');
        document.documentElement.dataset.theme =
          salvo === 'light' || salvo === 'dark'
            ? salvo
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
      } catch (e) {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
  </head>

  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-sm focus:bg-bg-raised focus:px-4 focus:py-2 focus:text-ink"
    >
      Pular para o conteúdo
    </a>

    <header class="fixed top-0 right-0 z-40 p-4 sm:p-6">
      <AlternarTema />
    </header>

    <main id="conteudo">
      <slot />
    </main>
  </body>
</html>
