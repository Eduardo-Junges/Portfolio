---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/instrument-serif/400.css';
import '../styles/global.css';

/*
 * As fontes só seriam descobertas depois de baixar e parsear o CSS. Estas duas
 * carregam o texto que o visitante lê primeiro (corpo e título), então vão em
 * preload para o download começar junto com o CSS, não depois dele.
 * A JetBrains Mono fica de fora de propósito: só aparece em rótulos pequenos e
 * números, e adiantá-la competiria por banda com as que importam.
 * `?url` faz o Vite devolver o caminho com hash — sem hardcode que quebra a cada build.
 */
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import serifLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import { profile } from '../data/profile';
import AlternarTema from '../components/ui/AlternarTema.astro';
import MenuEfeitos from '../components/ui/MenuEfeitos.astro';
import { ROTAS_DA_CENA, VERSAO_CENA } from '../data/cena';

/*
 * Analytics sem cookie e sem identificador de visitante: conta pageview e
 * referrer, não segue a pessoa entre sites. É por isso que não existe banner
 * de consentimento aqui — não há o que consentir.
 *
 * Em desenvolvimento o componente não envia nada; só o build de produção na
 * Vercel coleta, e só depois de Analytics estar habilitado no painel do
 * projeto. Sem isso, o script carrega e os eventos são descartados.
 */
import Analytics from '@vercel/analytics/astro';

interface Props {
  titulo?: string;
  descricao?: string;
  /** planeta do fundo vivo ('sol' = visão geral do sistema). Ver src/data/cena.ts */
  planeta?: string;
}

const { titulo = profile.seo.titulo, descricao = profile.seo.descricao, planeta = 'sol' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang={profile.seo.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    {/* imagem de compartilhamento — URL absoluta é exigência do protocolo OG */}
    <meta property="og:image" content={new URL('/og.jpg', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Eduardo Junges — projetos de automação, dados e sistemas" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      Resolve o tema antes do primeiro paint: escolha salva > preferência do
      sistema > dark. Fazer isso aqui, e não no CSS, mantém os tokens do tema
      claro declarados uma única vez em global.css.
    */}
    <script is:inline>
      // nível de efeitos (o mesmo vocabulário dos apps Nexus): decide brilho e entrada dos cartões
      try {
        var ef = localStorage.getItem('nx-efeitos');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) ef = 'desligado';
        else if (ef !== 'completo' && ef !== 'reduzido' && ef !== 'desligado')
          ef = window.matchMedia('(max-width: 767px), (pointer: coarse)').matches ? 'reduzido' : 'completo';
        document.documentElement.dataset.efeitos = ef;
      } catch (e) {
        document.documentElement.dataset.efeitos = 'completo';
      }
      try {
        var salvo = localStorage.getItem('tema');
        document.documentElement.dataset.theme =
          salvo === 'light' || salvo === 'dark'
            ? salvo
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
      } catch (e) {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
  </head>

  <body>
    {/*
      Fundo vivo "sistema solar" — o motor do Nexus Analytics (public/cena/).
      Decorativo: nenhuma informação vive no desenho. Só liga depois da página
      carregada; sem WebGL ou sem JS o site fica como antes, e com "reduzir
      movimento" vira um quadro parado.
    */}
    <canvas
      id="nx-cena"
      aria-hidden="true"
      data-auto="1"
      data-base="/cena/"
      data-versao={VERSAO_CENA}
      data-planeta={planeta}
      data-rotas={JSON.stringify(ROTAS_DA_CENA)}
      data-desloc="[-0.42,0.06]"></canvas>
    <div id="nx-cena-veu" aria-hidden="true"></div>
    <script is:inline src={`/cena/astro.js?v=${VERSAO_CENA}`} defer></script>
    <script is:inline src={`/cena/cena.js?v=${VERSAO_CENA}`} defer></script>

    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-sm focus:bg-bg-raised focus:px-4 focus:py-2 focus:text-ink"
    >
      Pular para o conteúdo
    </a>

    <header class="fixed top-0 right-0 z-40 flex items-start gap-2 p-4 sm:p-6">
      <MenuEfeitos />
      <AlternarTema />
    </header>

    <main id="conteudo">
      <slot />
    </main>

    {/* crédito exigido pela licença das texturas (CC BY 4.0) — vale para todas as páginas */}
    <footer class="container-page pb-10">
      <p class="max-w-2xl text-xs leading-relaxed text-ink-mute">
        Fundo: texturas de
        <a href="https://www.solarsystemscope.com/textures/" class="underline underline-offset-2 hover:text-ink" rel="noopener" target="_blank">Solar System Scope</a>
        (CC BY 4.0, a partir de dados da NASA) e estrelas do Yale Bright Star Catalogue. Posições
        dos planetas reais, calculadas para hoje.
      </p>
    </footer>

    <script>
      import '../lib/vida';
    </script>

    <Analytics />
  </body>
</html>
